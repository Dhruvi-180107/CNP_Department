diff --git a/frontend/src/hooks/useInView.ts b/frontend/src/hooks/useInView.ts
new file mode 100644
index 0000000..0968179
--- /dev/null
+++ b/frontend/src/hooks/useInView.ts
@@ -0,0 +1,29 @@
+import { useEffect, useRef, useState } from 'react';
+
+/** True once the element has scrolled into view (and stays true), for one-time reveal effects. */
+export function useInView<T extends Element>(threshold = 0.15) {
+  const ref = useRef<T | null>(null);
+  const [inView, setInView] = useState(false);
+
+  useEffect(() => {
+    const node = ref.current;
+    if (!node) return;
+    if (typeof IntersectionObserver === 'undefined') {
+      setInView(true);
+      return;
+    }
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) {
+          setInView(true);
+          observer.disconnect();
+        }
+      },
+      { threshold },
+    );
+    observer.observe(node);
+    return () => observer.disconnect();
+  }, [threshold]);
+
+  return { ref, inView };
+}
