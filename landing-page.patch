+              <path d="M5 12h14M13 6l6 6-6 6" />
+            </svg>
+          </Link>
+        </div>
+        <LaptopScene />
+      </div>
+      <a className="landing-scroll" href="#about" aria-label="Scroll to learn more">
+        <span />
+      </a>
+    </section>
+  );
+}
diff --git a/frontend/src/components/landing/LandingNav.tsx b/frontend/src/components/landing/LandingNav.tsx
