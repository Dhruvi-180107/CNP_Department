diff --git a/frontend/src/app.css b/frontend/src/app.css
index 592e997..94ccf9f 100644
--- a/frontend/src/app.css
+++ b/frontend/src/app.css
@@ -2801,3 +2801,199 @@ input[type="number"]:focus {
 @media (max-width: 768px) {
   .sidebar-container:not(.open) .main-sidebar { box-shadow: none; }
 }
+
+/* ═══════════════════════════════════════════════════════════════════════════
+   Landing page (public "/")
+   Convention: the base style is the FINAL state of every animation; keyframes
+   only describe where it starts. Turning motion off therefore just means
+   "no animation", and the scene shows its finished picture.
+   ═══════════════════════════════════════════════════════════════════════════ */
+#app:has(.landing) { display: block; width: 100%; height: auto; min-height: 100vh; overflow-x: hidden; overflow-y: auto; }
+
+.landing {
+  --l-ink: #0c1a47;
+  --l-muted: #51608a;
+  color: var(--l-ink);
+  background: #fff;
+  overflow-x: hidden;
+}
+.landing-container { width: min(1080px, 100% - 40px); margin-inline: auto; }
+
+/* Nav */
+.landing-nav {
+  position: fixed; inset: 0 0 auto 0; z-index: 50;
+  display: flex; align-items: center; gap: 24px;
+  padding: 14px clamp(16px, 4vw, 40px);
+  color: var(--navy-950); background: #fff;
+  border-bottom: 1px solid #e3e9f6;
+  transition: box-shadow .3s, padding .3s;
+}
+.landing-nav.is-scrolled { box-shadow: 0 6px 24px rgba(12, 26, 71, .12); padding-block: 10px; }
+.landing-brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; color: inherit; text-decoration: none; letter-spacing: .01em; }
+.landing-brand-mark { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: linear-gradient(135deg, var(--navy-700), var(--navy-950)); color: var(--gold); font-weight: 800; }
+.landing-nav-links { display: flex; gap: 22px; margin-left: auto; font-size: 14px; font-weight: 500; }
+.landing-nav-links a { color: var(--l-muted); text-decoration: none; transition: color .2s; }
+.landing-nav-links a:hover { color: var(--navy-700); }
+.landing-login {
+  padding: 8px 20px; border-radius: 999px; font-weight: 600; font-size: 14px; text-decoration: none;
+  color: #fff; background: linear-gradient(180deg, #2b4ba8, #183184); transition: transform .2s, box-shadow .2s;
+}
+.landing-login:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(24, 49, 132, .35); }
+
+/* Hero */
+.landing-hero {
+  position: relative; min-height: 100vh; min-height: 100svh;
+  display: grid; place-items: center; padding: 96px 16px 64px;
+  color: #fff;
+  background: radial-gradient(ellipse at 50% 40%, #16307f 0%, #0c1a47 55%, #060d26 100%);
+  overflow: hidden;
+}
+.landing-stars {
+  position: absolute; inset: 0; opacity: .55;
+  background-image:
+    radial-gradient(1.5px 1.5px at 12% 20%, #fff, transparent),
+    radial-gradient(1px 1px at 30% 70%, #fff, transparent),
+    radial-gradient(1.5px 1.5px at 62% 14%, #fff, transparent),
+    radial-gradient(1px 1px at 78% 62%, #fff, transparent),
+    radial-gradient(1.5px 1.5px at 90% 28%, #fff, transparent),
+    radial-gradient(1px 1px at 48% 88%, #fff, transparent),
+    radial-gradient(1px 1px at 6% 80%, #fff, transparent);
+  animation: landing-twinkle 5s ease-in-out infinite alternate;
+}
+.landing-stage {
+  position: relative; width: min(1180px, 100%);
+  display: grid; grid-template-columns: 1fr minmax(260px, 1.1fr) 1fr; align-items: center; gap: 8px;
+}
+
+/* Scenes */
+.landing-scene { --orbit-r: 152px; position: relative; width: min(100%, 340px); aspect-ratio: 1; margin-inline: auto; }
+.landing-rise { position: absolute; inset: 0; display: grid; place-items: center; animation: landing-rise 1.5s cubic-bezier(.2,.8,.2,1) .2s backwards; }
+.landing-rise-late { animation-delay: .6s; }
+
+/* Orbits */
+.landing-orbit { position: absolute; inset: 0; }
+.landing-orbit-ring { position: absolute; inset: calc(50% - var(--orbit-r)); border-radius: 50%; border: 1px dashed rgba(255,255,255,.18); }
+.landing-orbit-spin { position: absolute; inset: 0; animation: landing-spin var(--orbit-dur) linear infinite var(--orbit-dir); }
+.landing-orbit-item { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform: rotate(var(--a)) translateX(var(--orbit-r)); }
+.landing-orbit-icon {
+  position: absolute; left: -24px; top: -24px; width: 48px; height: 48px; display: grid; place-items: center;
+  border-radius: 50%; background: rgba(8, 16, 44, .7); border: 1px solid currentColor;
+  transform: rotate(calc(var(--a) * -1));
+  filter: drop-shadow(0 0 6px currentColor) drop-shadow(0 0 14px currentColor);
+  animation: landing-counter var(--orbit-dur) linear infinite var(--orbit-dir);
+}
+.landing-orbit-icon svg { filter: drop-shadow(0 0 3px currentColor); }
+
+/* Book */
+.landing-book { position: relative; width: 190px; height: 130px; perspective: 900px; transform: rotateX(18deg); transform-style: preserve-3d; }
+.landing-book-cover { position: absolute; inset: -8px -8px -12px; border-radius: 8px; background: linear-gradient(135deg, #7a2d1a, #4a1a0e); box-shadow: 0 18px 30px rgba(0,0,0,.45); }
+.landing-book-page { position: absolute; top: 0; bottom: 0; width: 50%; background: #f7f1e1; background-image: repeating-linear-gradient(transparent 0 11px, rgba(60,70,110,.16) 11px 12px); }
+.landing-book-left { left: 0; border-radius: 4px 0 0 4px; box-shadow: inset -10px 0 14px -8px rgba(0,0,0,.3); }
+.landing-book-right { right: 0; border-radius: 0 4px 4px 0; box-shadow: inset 10px 0 14px -8px rgba(0,0,0,.3); }
+.landing-book-spine { position: absolute; left: calc(50% - 1px); top: -2px; bottom: -2px; width: 2px; background: rgba(0,0,0,.45); }
+.landing-book-flip {
+  position: absolute; top: 0; bottom: 0; left: 50%; width: 50%;
+  transform-origin: left center; transform: rotateY(-180deg); z-index: calc(var(--i) + 1);
+  background: #fbf6e8; background-image: repeating-linear-gradient(transparent 0 11px, rgba(60,70,110,.16) 11px 12px);
+  border-radius: 0 4px 4px 0; box-shadow: 0 0 6px rgba(0,0,0,.2);
+  /* fast at first, slower and slower: both the wait and the flip itself grow with --i */
+  animation: landing-flip calc(.3s + var(--i) * .1s) ease-in-out calc(1.2s + var(--i) * var(--i) * .07s) backwards;
+}
+
+/* Laptop */
+.landing-laptop { width: 210px; }
+.landing-laptop-lid { padding: 8px; border-radius: 10px 10px 0 0; background: #1b2347; border: 1px solid rgba(255,255,255,.12); }
+.landing-laptop-screen { position: relative; height: 128px; border-radius: 4px; overflow: hidden; background: #050a1c; box-shadow: inset 0 0 18px rgba(0,255,150,.12); }
+.landing-laptop-base { height: 10px; margin-inline: -14px; border-radius: 0 0 14px 14px; background: linear-gradient(#aeb5cc, #6f7799); box-shadow: 0 14px 24px rgba(0,0,0,.45); }
+.landing-code { position: absolute; inset: 0; padding: 8px; opacity: 0; animation: landing-code-life 4.6s linear 1.7s backwards; }
+.landing-code-track { font: 10px/16px ui-monospace, 'SF Mono', Menlo, monospace; color: #4dff9d; text-shadow: 0 0 6px rgba(77,255,157,.6); white-space: nowrap; animation: landing-code-scroll .7s linear 1.7s 6; }
+.landing-smiley { position: absolute; inset: 0; display: grid; place-items: center; color: #4dff9d; filter: drop-shadow(0 0 8px rgba(77,255,157,.7)); animation: landing-pop .7s cubic-bezier(.3,1.6,.5,1) 6.2s backwards; }
+
+/* Welcome text */
+.landing-welcome { text-align: center; padding: 0 8px; }
+.landing-welcome h1 { font-size: clamp(30px, 4.2vw, 50px); line-height: 1.12; font-weight: 700; animation: landing-title 2.6s ease-out 1.6s backwards; }
+.landing-welcome h1 span { display: block; color: var(--gold); }
+.landing-welcome p { margin: 16px auto 0; max-width: 40ch; color: rgba(255,255,255,.78); animation: landing-fade 1.4s ease-out 3.4s backwards; }
+.landing-cta {
+  display: inline-flex; align-items: center; gap: 10px; margin-top: 26px; padding: 14px 28px; border-radius: 999px;
+  font-weight: 700; color: var(--navy-950); text-decoration: none;
+  background: linear-gradient(135deg, #f3cf86, var(--gold));
+  box-shadow: 0 0 0 0 rgba(227,176,75,.5), 0 10px 26px rgba(227,176,75,.3);
+  transition: transform .2s;
+  animation: landing-fade 1.2s ease-out 4.2s backwards, landing-glow 2.8s ease-out 5.6s infinite;
+}
+.landing-cta:hover { transform: translateY(-2px) scale(1.03); }
+.landing-cta svg { transition: transform .2s; }
+.landing-cta:hover svg { transform: translateX(4px); }
+.landing-scroll { position: absolute; bottom: 18px; left: 50%; width: 22px; height: 36px; margin-left: -11px; border: 2px solid rgba(255,255,255,.45); border-radius: 12px; animation: landing-fade 1s ease-out 5s backwards; }
+.landing-scroll span { position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: #fff; animation: landing-wheel 1.8s ease-in-out infinite; }
+
+/* Sections */
+.landing-section { padding: clamp(56px, 9vw, 104px) 0; }
+.landing-section-tint { background: #f2f5fc; }
+.landing-section-dark { background: var(--navy-950); color: #fff; }
+.landing-eyebrow { font-size: 12.5px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--navy-700); }
+.landing-section-dark .landing-eyebrow { color: var(--gold); }
+.landing-section h2 { margin-top: 8px; font-size: clamp(26px, 3.6vw, 38px); line-height: 1.2; font-weight: 700; }
+.landing-lead { margin-top: 18px; max-width: 70ch; font-size: 16.5px; line-height: 1.75; color: var(--l-muted); }
+.landing-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-top: 32px; }
+.landing-card { padding: 22px; border-radius: 16px; background: #fff; border: 1px solid #dde4f4; box-shadow: 0 10px 28px rgba(15,34,98,.06); }
+.landing-section-tint .landing-card { background: #fff; }
+.landing-card h3 { font-size: 17px; margin-bottom: 6px; }
+.landing-card p { color: var(--l-muted); font-size: 14.5px; line-height: 1.65; }
+.landing-vision { margin-top: 32px; padding: 22px 26px; border-left: 4px solid var(--gold); border-radius: 0 14px 14px 0; background: #f2f5fc; color: var(--l-ink); line-height: 1.7; }
+.landing-vision strong { display: block; margin-bottom: 4px; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--navy-700); }
+.landing-steps { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 32px; }
+.landing-step { display: flex; gap: 14px; padding: 20px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); }
+.landing-step-n { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: var(--navy-950); font-weight: 800; }
+.landing-step h3 { font-size: 16.5px; margin-bottom: 4px; }
+.landing-step p { color: rgba(255,255,255,.72); font-size: 14.5px; line-height: 1.6; }
+.landing-footer { padding: 22px 0; background: #060d26; color: rgba(255,255,255,.65); font-size: 13.5px; }
+.landing-footer .landing-container { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
+.landing-footer a { color: var(--gold); text-decoration: none; }
+
+/* Scroll reveal */
+.landing-reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
+.landing-reveal.is-in { opacity: 1; transform: none; }
+
+/* Keyframes (start states only) */
+@keyframes landing-rise { from { opacity: 0; transform: translateY(160px); } }
+@keyframes landing-flip { from { transform: rotateY(0deg); z-index: calc(20 - var(--i)); } 50% { z-index: calc(20 - var(--i)); } 51% { z-index: calc(var(--i) + 1); } }
+@keyframes landing-spin { to { transform: rotate(360deg); } }
+@keyframes landing-counter { to { rotate: -360deg; } }
+@keyframes landing-code-scroll { to { transform: translateY(-50%); } }
+@keyframes landing-code-life { 0% { opacity: 0; } 6%, 86% { opacity: 1; } 100% { opacity: 0; } }
+@keyframes landing-pop { from { opacity: 0; transform: scale(.4); } }
+@keyframes landing-title { from { opacity: 0; letter-spacing: .22em; filter: blur(6px); } }
+@keyframes landing-fade { from { opacity: 0; transform: translateY(10px); } }
+@keyframes landing-glow { to { box-shadow: 0 0 0 16px rgba(227,176,75,0), 0 10px 26px rgba(227,176,75,.3); } }
+@keyframes landing-wheel { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }
+@keyframes landing-twinkle { to { opacity: .25; } }
+
+/* Static mode: signed-in visitors and anyone preferring reduced motion get the finished scene */
+.landing[data-motion="off"] *, .landing[data-motion="off"] *::before, .landing[data-motion="off"] *::after { animation: none !important; transition: none !important; }
+.landing[data-motion="off"] .landing-reveal { opacity: 1; transform: none; }
+@media (prefers-reduced-motion: reduce) {
+  .landing *, .landing *::before, .landing *::after { animation: none !important; transition: none !important; }
+  .landing .landing-reveal { opacity: 1; transform: none; }
+  html { scroll-behavior: auto; }
+}
+
+/* Responsive */
+@media (max-width: 960px) {
+  .landing-nav-links { display: none; }
+  .landing-login { margin-left: auto; }
+  .landing-stage { grid-template-columns: 1fr 1fr; grid-template-areas: "book laptop" "welcome welcome"; gap: 24px 0; }
+  .landing-scene-book { grid-area: book; }
+  .landing-scene-laptop { grid-area: laptop; }
+  .landing-welcome { grid-area: welcome; }
+  .landing-scene { --orbit-r: 112px; width: min(100%, 260px); }
+  .landing-book { transform: rotateX(18deg) scale(.82); }
+  .landing-laptop { transform: scale(.82); }
+}
+@media (max-width: 480px) {
+  .landing-scene { --orbit-r: 78px; width: min(100%, 180px); }
+  .landing-orbit-icon { transform-origin: center; scale: .72; }
+  .landing-book { transform: rotateX(18deg) scale(.58); }
+  .landing-laptop { transform: scale(.58); }
+}
